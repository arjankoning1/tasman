 ########## USER INPUT ##########

 USER INPUT FILE

 #
 # general
 #
 projectile n
 element nb
 mass 93
 energy energies
 channels y
 filechannels y
 bins 20
 outangle y
 fileangle 0
 fileangle 1
 fileangle 2
 fileangle 3
 fileangle 4
 #
 # tasman keywords start here
 #
 #change
 #mode 1
 #ntalys 20
 #seed 3042015
 #band y
 #save y
 #angle y
 #isomer y
 #expinclude all
 ##
 ## parameters to be varied
 ##
 rvadjust n 1.
 avadjust n 1.
 v1adjust n 1. 0.05
 v2adjust n 1.
 rwdadjust n 1. 0.10
 awdadjust n 1. 0.05
 aadjust 41 94 1. 0.15
 aadjust 41 93 1. 0.15
 aadjust 40 93 1. 0.15

 USER INPUT FILE + DEFAULTS

 Keyword           Value   Variable     Explanation

 #
 # Main TASMAN keywords
 #
 #mode               1     mode         mode for TASMAN: Monte Carlo covariances 
 #Ntalys            20     Ntalys       number of TALYS runs 
 #Nburn             20     Nburn        number of burn-in runs 
 #Nhigh             20     Nhigh        number of high energy runs 
 #Ehigh       1000.000     Ehigh        energy cutoff of high energy runs 
 #Liso               0     Liso         number of the isomeric state 
 #maxgam             4     maxgam       maximum number of discrete levels with gamma cross section
 #minbar             0     minbar       minimum number of fission barriers
 #maxbar             3     maxbar       maximum number of fission barriers
 #cross              y     flagcross    flag for covariances or optimization of cross sections
 #angle              y     flagangle    flag for covariances or optimization of angular distributions
 #legendre           n     flagleg      flag for covariances or optimization of Legendre coefficients
 #spectra            n     flagspectra  flag for covariances or optimization of emission spectra
 #gamma              n     flaggamma    flag for covariances or optimization of discrete gamma ray transitions
 #residual           n     flagresidual flag for covariances or optimization of residual production cross sections
 #prod               n     flagprod     flag for covariances or optimization of particle production cross sections
 #production         n     flagproduct  flag for covariances or optimization of isotope production
 #discrete           n     flagdiscrete flag for covariances or optimization of discrete level cross sections
 #isomer             y     flagisomer   flag for covariances or optimization of isomeric production cross sections
 #ompinc             y     flagompinc   flag to vary OMP parameters for incident channel
 #omponly            n     flagomponly  flag for covariances or optimization for basic optical model observables
 #integral           n     flagintegral flag for covariances or optimization of integral activation data
 #macs               n     flagmacs     flag for covariances or optimization of Maxwellian averaged cross sections
 #gamgam             n     flaggamgam   flag for covariances or optimization of average radiative width
 #psf                n     flagpsf      flag for optimization of photon strength functions
 #ld                 n     flagld       flag for optimization of level density parameters
 #sample             n     flagsample   flag for sampling experimental data 
 #talysversion talys       talysversion version of TALYS
 #user   Arjan Koning      user         user for this calculation
 #source TASMAN            source       source for this calculation
 #format YANDF-0.4         oformat      format for output
 #
 # Keywords for mode 1
 #
 #offset             0     offset       offset for numbering or random files (TMC only) 
 #tmcoffset          0     tmcoffset    offset for starting creation of ENDF-6 files (TMC only)
 #seed         3042015     seed         seed for random number generator 
 #cwidth   1.00000E+00     cwidth       scaling constant for parameter variation 
 #fiscor   2.00000E+00     fiscor0      adjustment parameter for fission uncertainties
 #ecis               y     flagecis     flag to repeat ECIS calculations in a second run 
 #block              y     flagblock    flag to block spectra, angle and gamma files
 #gauss              y     flaggauss    flag to sample parameters from a Gaussian instead of a uniform distribution
 #save               y     flagsave     flag to save all input and output files of each TALYS run 
 #tmc                n     flagtmc      flag for Total Monte Carlo (ENDF-6 data file at each run
 #select             n     flagselect   flag for varying only parts of an ENDF-6 data file
 #covrand            n     flagcovrand  flag for covariance ENDF-6 file after every random run
 #gpf                y     flaggpf      flag for creation of ENDF general purpose file 
 #sdefault           y     flagsdefault flag for creation of ENDF general purpose file with default switch (30 MeV for neutrons, 0 for other particles)
 #defonly            y     defonly      flag for creation of ENDF default file only
 #s20                n     flags20      flag for creation of ENDF general purpose file with switch at 20 MeV
 #s30                n     flags30      flag for creation of ENDF general purpose file with switch at 30 MeV
 #s60                n     flags60      flag for creation of ENDF general purpose file with switch at 60 MeV
 #mt                 n     flagmt       flag for creation of ENDF general purpose file without switch
 #acf                n     flagacf      flag for creation of ENDF activation file 
 #eaf                n     flageaf      flag for creation of EAF activation file 
 #prepro             y     flagprepro   flag to run PREPRO codes
 #njoy               y     flagnjoy     flag to run NJOY
 #proconly           y     flagproconly flag for processing of ENDF default file only
 #purr               n     flagpurr     flag to run PURR in NJOY
 #resonance          y     flagres      flag for variation of resonance parameters for ENDF-6 general purpose file
 #runtares           n     flagruntares flag to produce resonances in TASMAN with TARES
 #nubar              n     flagnubar    flag for variation of nubar values for ENDF-6 general purpose file
 #runnubar           n     flagrunnubar flag to produce nubar in TASMAN with TAFIS
 #fns                n     flagfns      flag or variation of fission neutron spectrum for ENDF-6 general purpose file 
 #tefalversion tefal       tefalversion version of TEFAL 
 #taresversion tares       taresversion version of TARES 
 #tafisversion tafis       tafisversion version of TAFIS 
 #tanesversion tanes       tanesversion version of TANES 
 #tareslib default         tareslib     library name for adoption of resonance parameters
 #background               background   library name for adoption of background cross sections in MF3
 #lrf7               n     flaglrf7     flag for resonance representation
 #tafislib none            tafislib     library name for adoption of nubar values
 #taneslib none            taneslib     library name for adoption of fission neutron spectrum
 #mcak               n     flagmcak     flag to use sampling from arbitrary distribution
 #readpar            n     flagreadpar  flag to read in parameter distribution
 #parameters         n     flagparvary  flag to vary tabulated nuclear model parameters
 #allpar             n     flagallpar   flag to vary all nuclear model parameters
 #weight             y     flagweight   flag to use weights for random samples
 #eweight            n     flageweight  flag to use energy-dependent weights 
 #metropolis         n     flagmetro    flag for Metropolis sampling
 #kdburn             y     flagkdburn   flag to use KD03 OMP function for burn-in
 #magnet             n     flagmagnet   flag to push TALYS data to experimental or library data
 #global             n     flagglobal   flag to use global TALYS cross sections as prior
 #autoinclude        y     flagautoinc  flag to automatically in- or exclude important channels
 #edependent         y     flagedep     flag for energy dependence of uncertainties
 #equisample         y     flagequisam  flag to use equal binning uniform sampling
 #gofmode            1     gofmode      1: exp(-0.5*G) 2: exp(-0.5*G/G0) 3: exp(-(G/G0)**weightpower GOF weight
 #maxexpsets   1000000     maxexpsets   number of experimental data sets before weight reduction
 #average            2     average      average cross sections 1: average, 2: first run 3: optimum
 #inponly            n     flaginponly  flag to produce only TALYS input files, no runs

