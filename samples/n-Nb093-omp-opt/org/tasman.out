 ########## USER INPUT ##########

 USER INPUT FILE

 #
 # general
 #
 projectile n
 element nb
 mass 93
 energy energies
 bins 20
 omponly y
 #
 # tasman keywords start here
 #
 #change
 #mode 3
 #ntalys 100
 #expinclude 1
 ##
 ## parameters to be varied
 ##
 rvadjust n 1.
 avadjust n 1.
 v1adjust n 1.
 v2adjust n 1.
 d1adjust n 1.
 d2adjust n 1.
 d3adjust n 1.
 rwdadjust n 1.
 awdadjust n 1.

 USER INPUT FILE + DEFAULTS

 Keyword           Value   Variable     Explanation

 #
 # Main TASMAN keywords
 #
 #mode               3     mode         mode for TASMAN: optimization with experimental data for one nucleus 
 #Ntalys           100     Ntalys       number of TALYS runs 
 #Nburn             -1     Nburn        number of burn-in runs 
 #Nhigh             -1     Nhigh        number of high energy runs 
 #Ehigh       1000.000     Ehigh        energy cutoff of high energy runs 
 #Liso               0     Liso         number of the isomeric state 
 #maxgam             4     maxgam       maximum number of discrete levels with gamma cross section
 #minbar             0     minbar       minimum number of fission barriers
 #maxbar             3     maxbar       maximum number of fission barriers
 #cross              y     flagcross    flag for covariances or optimization of cross sections
 #angle              n     flagangle    flag for covariances or optimization of angular distributions
 #legendre           n     flagleg      flag for covariances or optimization of Legendre coefficients
 #spectra            n     flagspectra  flag for covariances or optimization of emission spectra
 #gamma              n     flaggamma    flag for covariances or optimization of discrete gamma ray transitions
 #residual           n     flagresidual flag for covariances or optimization of residual production cross sections
 #prod               n     flagprod     flag for covariances or optimization of particle production cross sections
 #production         n     flagproduct  flag for covariances or optimization of isotope production
 #discrete           n     flagdiscrete flag for covariances or optimization of discrete level cross sections
 #isomer             n     flagisomer   flag for covariances or optimization of isomeric production cross sections
 #ompinc             y     flagompinc   flag to vary OMP parameters for incident channel
 #omponly            n     flagomponly  flag for covariances or optimization for basic optical model observables
 #integral           n     flagintegral flag for covariances or optimization of integral activation data
 #macs               n     flagmacs     flag for covariances or optimization of Maxwellian averaged cross sections
 #gamgam             n     flaggamgam   flag for covariances or optimization of average radiative width
 #psf                n     flagpsf      flag for optimization of photon strength functions
 #ld                 n     flagld       flag for optimization of level density parameters
 #sample             n     flagsample   flag for sampling experimental data 
 #talysversion talys       talysversion version of TALYS
 #user   Arjan Koning      user         user for this calculation
 #source TASMAN            source       source for this calculation
 #format YANDF-0.4         oformat      format for output
 #
 # Keywords for mode 3
 #
 #chi2               1     ichi2        parameter to set goodness-of-fit estimator 
 #weightpower        2.000 weightpower  power for weight of random run
 #readsens           n     flagreadsens flag to read sensitivities from tables
 #sens               n     flagsens     flag to use sensitivity in parameter weighting
 #deltaE             n     flagdeltaE   flag to weigh goodness-of-fit with dE of energy grid
 #dexp               y     flagdexp     flag to include exp. uncertainty in C/E
 #erf                y     flagerf      flag to use error function for Frms
 #band               n     flagband     flag to represent results as error bands 
 #E1vary             y     flagE1vary   flag to automatically vary keywords for E1 radiation
 #M1vary             n     flagM1vary   flag to automatically vary keywords for M1 radiation
 #score              y     flagscore    flag to use scores for inclusion or exclusion
 #error              y     flagerror    flag to include true experimental uncertainties
 #expclass           3     expclass     quality class of experimental data (1, 2 or 3)
 #sort               y     flagsort     flag to sort experimental data in increasing energies in the output
 #outsearch          5     outsearch    level of output of search (1 (minimal) - 5 (all))

